From: a <a@b>
Date: Sat, 24 Oct 2026 19:49:18 +0000
Subject: [PATCH 53/72] 0054-string-eq-pointer-identity.patch

---
 quickjs.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/quickjs.c b/quickjs.c
index 72b38a0..5dbf1b6 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -5798,6 +5798,8 @@ static int js_string_memcmp(JSString *p1, JSString *p2, int len)
 }
 
 static bool js_string_eq(JSString *p1, JSString *p2) {
+    if (p1 == p2)
+        return true;
     if (p1->len != p2->len)
         return false;
     return js_string_memcmp(p1, p2, p1->len) == 0;
