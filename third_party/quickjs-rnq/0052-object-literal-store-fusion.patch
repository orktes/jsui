+            ev[n].pos = st->def_pos[k];
+            ev[n].site = i;
+            ev[n].ord = k;
+            n++;
+        }
+    }
+    qsort(ev, n, sizeof(D3Ev), d3_ev_cmp);
+    *pn = n;
+    return ev;
