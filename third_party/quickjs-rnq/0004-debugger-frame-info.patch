From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: a <a@b>
Date: Sat, 24 Oct 2026 19:49:11 +0000
Subject: [PATCH 04/72] 0004-debugger-frame-info.patch

---
 quickjs.c | 63 +++++++++++++++++++++++++++++++++++++++++++++++++++++++
 quickjs.h | 17 +++++++++++++++
 2 files changed, 80 insertions(+)

diff --git a/quickjs.c b/quickjs.c
index 0cb35bf..85e2179 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -3280,6 +3280,51 @@ JSValue JS_EvalInStackFrame(JSContext *ctx, int level,
     return ret;
 }
 
+/* Defined much later in the file; declared here so the debugger block, which
+   sits early enough to be next to the rest of the debug API, can use them. */
+static bool js_class_has_bytecode(JSClassID class_id);
+static int find_line_num(JSContext *ctx, JSFunctionBytecode *b,
+                         uint32_t pc_value, int *col);
+
+int JS_GetFrameInfoAtLevel(JSContext *ctx, int level, JSDebugFrameInfo *info)
+{
+    JSStackFrame *sf;
+    JSObject *p;
+    JSFunctionBytecode *b;
+
+    if (!info)
+        return -1;
+    memset(info, 0, sizeof(*info));
+    info->filename = JS_ATOM_NULL;
+    info->func_name = JS_ATOM_NULL;
+    info->line = -1;
+    info->col = -1;
+
+    sf = js_get_stack_frame_at_level(ctx, level);
+    if (sf == NULL)
+        return -1;
+
+    if (JS_VALUE_GET_TAG(sf->cur_func) != JS_TAG_OBJECT) {
+        info->is_native = true;
+        return 0;
+    }
+    p = JS_VALUE_GET_OBJ(sf->cur_func);
+    if (!js_class_has_bytecode(p->class_id)) {
+        info->is_native = true;
+        return 0;
+    }
+
+    b = p->u.func.function_bytecode;
+    info->filename = b->filename;
+    info->func_name = b->func_name;
+    if (sf->cur_pc) {
+        /* cur_pc points just past the executing instruction */
+        uint32_t pc = (uint32_t)(sf->cur_pc - b->byte_code_buf - 1);
+        info->line = find_line_num(ctx, b, pc, &info->col);
+    }
+    return 0;
+}
+
 #else /* !JS_ENABLE_DEBUGGER */
 
 /* Stubs so an embedder built against the full header still links.  They fail
@@ -3328,6 +3373,19 @@ JSValue JS_EvalInStackFrame(JSContext *ctx, int level, const char *input,
                                  "debugger not compiled in (JS_ENABLE_DEBUGGER=0)");
 }
 
+int JS_GetFrameInfoAtLevel(JSContext *ctx, int level, JSDebugFrameInfo *info)
+{
+    (void)ctx; (void)level;
+    if (!info)
+        return -1;
+    memset(info, 0, sizeof(*info));
+    info->filename = JS_ATOM_NULL;
+    info->func_name = JS_ATOM_NULL;
+    info->line = -1;
+    info->col = -1;
+    return -1;
+}
+
 #endif /* JS_ENABLE_DEBUGGER */
 
 typedef enum JSFreeModuleEnum {
@@ -18602,6 +18660,11 @@ static JSValue JS_CallInternal(JSContext *caller_ctx, JSValueConst func_obj,
                     uint32_t pc_index = (uint32_t)(pc - b->byte_code_buf - 2);
                     line_num = find_line_num(ctx, b, pc_index, &col_num);
 
+                    /* JS_CallInternal keeps pc in a local and only writes
+                       sf->cur_pc where it can re-enter the engine; the trap
+                       is such a point, so publish it for the trapping frame. */
+                    sf->cur_pc = pc;
+
                     /* Pass the JSAtom values directly -- no heap allocation.
                        The atoms are valid for the lifetime of the bytecode
                        object, which outlives the callback.  The embedder must
diff --git a/quickjs.h b/quickjs.h
index d170970..8e76794 100644
--- a/quickjs.h
+++ b/quickjs.h
@@ -640,6 +640,23 @@ JS_EXTERN JSValue JS_EvalInStackFrame(JSContext *ctx, int level,
                                       const char *input, size_t input_len,
                                       const char *filename);
 
+/* Source location and function identity of one live stack frame. `filename`
+   and `func_name` are borrowed atoms, valid only while the frame is alive;
+   JS_DupAtom() to retain. `line`/`col` are -1 when unavailable. */
+typedef struct JSDebugFrameInfo {
+    JSAtom filename;   /* borrowed; JS_ATOM_NULL if unknown */
+    JSAtom func_name;  /* borrowed; JS_ATOM_NULL for anonymous functions */
+    int line;          /* 1-based, or -1 */
+    int col;           /* 1-based, or -1 */
+    bool is_native;    /* true for a C function frame */
+} JSDebugFrameInfo;
+
+/* Fill *info for the frame at `level` (0 = the innermost frame, 1 = its
+   caller).  Returns 0 on success and -1 if `level` is out of range, in which
+   case *info is zero-filled.  Never throws. */
+JS_EXTERN int JS_GetFrameInfoAtLevel(JSContext *ctx, int level,
+                                     JSDebugFrameInfo *info);
+
 /* the following functions are used to select the intrinsic object to
    save memory */
 JS_EXTERN JSContext *JS_NewContextRaw(JSRuntime *rt);
