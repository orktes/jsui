From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: a <a@b>
Date: Sat, 24 Oct 2026 19:49:11 +0000
Subject: [PATCH 02/72] 0002-deferred-gc-control.patch

---
 quickjs.c | 41 +++++++++++++++++++++++++++++++++++++++++
 quickjs.h |  7 +++++++
 2 files changed, 48 insertions(+)

diff --git a/quickjs.c b/quickjs.c
index c7fc5ce..c03aa01 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -361,6 +361,9 @@ struct JSRuntime {
     struct list_head tmp_obj_list; /* used during GC */
     JSGCPhaseEnum gc_phase : 8;
     size_t malloc_gc_threshold;
+    bool gc_deferred; /* see JS_SetGCDeferred */
+    bool gc_pending;
+    size_t gc_deferred_limit;
 #ifdef ENABLE_DUMPS // JS_DUMP_LEAKS
     struct list_head string_list; /* list of JSString.link */
 #endif
@@ -1687,12 +1690,21 @@ static void js_trigger_gc(JSRuntime *rt, size_t size)
                 rt->malloc_gc_threshold);
 #endif
     if (force_gc) {
+        /* deferred: collect at the next safepoint, not under running JS */
+        if (rt->gc_deferred && rt->current_stack_frame != NULL &&
+            (rt->malloc_state.malloc_size + size) < rt->gc_deferred_limit) {
+            rt->gc_pending = true;
+            rt->malloc_gc_threshold = rt->malloc_state.malloc_size +
+                (rt->malloc_state.malloc_size >> 1);
+            return;
+        }
 #ifdef ENABLE_DUMPS // JS_DUMP_GC
         if (check_dump_flag(rt, JS_DUMP_GC)) {
             printf("GC: size=%zd\n", rt->malloc_state.malloc_size);
         }
 #endif
         JS_RunGC(rt);
+        rt->gc_pending = false;
         rt->malloc_gc_threshold = rt->malloc_state.malloc_size +
             (rt->malloc_state.malloc_size >> 1);
     }
@@ -7480,6 +7492,35 @@ static void gc_free_cycles(JSRuntime *rt)
     init_list_head(&rt->gc_zero_ref_count_list);
 }
 
+void JS_SetGCDeferred(JSRuntime *rt, bool deferred, size_t limit)
+{
+    rt->gc_deferred = deferred;
+    /* 0: derive a ceiling from the current threshold */
+    rt->gc_deferred_limit = limit != 0 ? limit : rt->malloc_gc_threshold * 4;
+    if (!deferred && rt->gc_pending) {
+        rt->gc_pending = false;
+        JS_RunGC(rt);
+        rt->malloc_gc_threshold = rt->malloc_state.malloc_size +
+            (rt->malloc_state.malloc_size >> 1);
+    }
+}
+
+bool JS_HasPendingGC(JSRuntime *rt)
+{
+    return rt->gc_pending;
+}
+
+void JS_RunPendingGC(JSRuntime *rt)
+{
+    if (!rt->gc_pending)
+        return;
+    assert(rt->current_stack_frame == NULL);
+    rt->gc_pending = false;
+    JS_RunGC(rt);
+    rt->malloc_gc_threshold = rt->malloc_state.malloc_size +
+        (rt->malloc_state.malloc_size >> 1);
+}
+
 size_t JS_GetMallocSize(JSRuntime *rt)
 {
     return rt->malloc_state.malloc_size;
diff --git a/quickjs.h b/quickjs.h
index 5edfd71..582b3fc 100644
--- a/quickjs.h
+++ b/quickjs.h
@@ -530,6 +530,13 @@ JS_EXTERN void JS_MarkValue(JSRuntime *rt, JSValueConst val,
                             JS_MarkFunc *mark_func);
 JS_EXTERN void JS_RunGC(JSRuntime *rt);
 JS_EXTERN size_t JS_GetMallocSize(JSRuntime *rt);
+/* Defer collections triggered while JS is running; JS_RunPendingGC then runs
+   them at a safepoint. `limit` bytes is a hard ceiling past which the engine
+   collects anyway; 0 derives one from the current threshold. */
+JS_EXTERN void JS_SetGCDeferred(JSRuntime *rt, bool deferred, size_t limit);
+JS_EXTERN bool JS_HasPendingGC(JSRuntime *rt);
+/* Must be called with an empty JS stack. */
+JS_EXTERN void JS_RunPendingGC(JSRuntime *rt);
 JS_EXTERN bool JS_IsLiveObject(JSRuntime *rt, JSValueConst obj);
 
 JS_EXTERN JSContext *JS_NewContext(JSRuntime *rt);
