 /* also used to initialize the worker context */
+/* engine-bench: deferred-GC hook (QJS_GC_DEFERRED=1) */
+static JSValue js_run_pending_gc(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)
+{
+    JSRuntime *rt = JS_GetRuntime(ctx);
+    bool pending = JS_HasPendingGC(rt);
+    JS_RunPendingGC(rt);
+    /* re-derive the ceiling like react-native-quickjs's runtime (deferredGCLimit 0):
+       live + clamp(live, 48 MiB, 256 MiB) */
+    size_t live = JS_GetMallocSize(rt), slack = live;
+    if (slack < 48u << 20) slack = 48u << 20;
+    if (slack > 256u << 20) slack = 256u << 20;
+    JS_SetGCDeferred(rt, true, live + slack);
+    return JS_NewBool(ctx, pending);
+}
