# Embeds the bundled default fonts (assets/fonts/*.ttf) into the library so
# text renders identically everywhere without system fonts.
#
# Used two ways:
#   include(EmbedFonts); jsui_embed_fonts(<target>)   - from CMakeLists.txt
#   cmake -DOUT=<file.cpp> -DFONTS="Family|weight|italic|path,..." -P EmbedFonts.cmake
#                                                       - the build-time generator

if(CMAKE_SCRIPT_MODE_FILE)
  set(_src "// Generated by cmake/EmbedFonts.cmake. Do not edit.\n#include \"text/embedded_fonts.h\"\n\nnamespace jsui {\nnamespace {\n")
  set(_table "")
  set(_i 0)
  # Entries arrive comma separated (a ';' list does not survive the command line).
  string(REPLACE "," ";" _font_list "${FONTS}")
  foreach(_entry IN LISTS _font_list)
    string(REPLACE "|" ";" _parts "${_entry}")
    list(GET _parts 0 _family)
    list(GET _parts 1 _weight)
    list(GET _parts 2 _italic)
    list(GET _parts 3 _path)
    file(READ "${_path}" _hex HEX)
    string(LENGTH "${_hex}" _len)
    math(EXPR _size "${_len} / 2")
    # 0xNN, per byte; a newline every 32 bytes keeps lines short.
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],))" "\\1\n" _bytes "${_bytes}")
    string(APPEND _src "const unsigned char kFont${_i}[${_size}] = {\n${_bytes}\n};\n")
    string(APPEND _table "    {\"${_family}\", ${_weight}, ${_italic}, kFont${_i}, ${_size}},\n")
    math(EXPR _i "${_i} + 1")
  endforeach()
  string(APPEND _src "}  // namespace\n\nconst EmbeddedFont kEmbeddedFonts[] = {\n${_table}};\nconst size_t kEmbeddedFontCount = ${_i};\n\n}  // namespace jsui\n")
  file(WRITE "${OUT}.tmp" "${_src}")
  file(RENAME "${OUT}.tmp" "${OUT}")
  return()
endif()

function(jsui_embed_fonts target)
  set(_dir ${CMAKE_SOURCE_DIR}/assets/fonts)
  set(_fonts
    "Inter|400|0|${_dir}/Inter-Regular.ttf"
    "Inter|500|0|${_dir}/Inter-Medium.ttf"
    "Inter|600|0|${_dir}/Inter-SemiBold.ttf"
    "Inter|700|0|${_dir}/Inter-Bold.ttf"
    "Inter|400|1|${_dir}/Inter-Italic.ttf")
  set(_deps "")
  foreach(_f IN LISTS _fonts)
    string(REPLACE "|" ";" _p "${_f}")
    list(GET _p 3 _path)
    list(APPEND _deps ${_path})
  endforeach()
  set(_out ${CMAKE_BINARY_DIR}/generated/jsui_embedded_fonts.cpp)
  string(REPLACE ";" "," _fonts_arg "${_fonts}")
  add_custom_command(
    OUTPUT ${_out}
    COMMAND ${CMAKE_COMMAND} -E make_directory ${CMAKE_BINARY_DIR}/generated
    COMMAND ${CMAKE_COMMAND} -DOUT=${_out} "-DFONTS=${_fonts_arg}" -P ${CMAKE_SOURCE_DIR}/cmake/EmbedFonts.cmake
    DEPENDS ${_deps} ${CMAKE_SOURCE_DIR}/cmake/EmbedFonts.cmake
    COMMENT "Embedding default fonts"
    VERBATIM)
  target_sources(${target} PRIVATE ${_out})
endfunction()
