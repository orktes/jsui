<?xml version="1.0" encoding="utf-8"?>
<!-- JsuiDemo: a NativeActivity (no Java code) whose native library is
     libjsuidemo.so. Packaged by scripts/build-android.sh. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.orktes.jsui.demo"
    android:versionCode="1"
    android:versionName="0.1">

  <uses-feature android:glEsVersion="0x00030000" android:required="true" />
  <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
  <uses-feature android:name="android.hardware.gamepad" android:required="false" />
  <!-- Dev mode loads the bundle from `jsui dev` (http://10.0.2.2:5173 in the emulator). -->
  <uses-permission android:name="android.permission.INTERNET" />

  <application
      android:label="JSUI Demo"
      android:hasCode="false"
      android:usesCleartextTraffic="true"
      android:extractNativeLibs="false"
      android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
    <activity
        android:name="android.app.NativeActivity"
        android:exported="true"
        android:screenOrientation="sensorLandscape"
        android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|smallestScreenSize"
        android:launchMode="singleTask">
      <meta-data android:name="android.app.lib_name" android:value="jsuidemo" />
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
        <category android:name="android.intent.category.GAME" />
      </intent-filter>
    </activity>
  </application>
</manifest>
