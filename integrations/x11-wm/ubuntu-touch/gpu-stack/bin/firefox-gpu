#!/bin/sh
# Firefox with WebRender on the GPU (Zink/Turnip), separate profile under ~/gpu-stack so the
# software-rendering profile in ~/.config/mozilla stays untouched.
P="$HOME/gpu-stack/profiles/firefox"
mkdir -p "$P"
cat > "$P/user.js" <<'J'
user_pref("gfx.webrender.software", false);
user_pref("gfx.webrender.all", true);
user_pref("layers.acceleration.disabled", false);
user_pref("layers.acceleration.force-enabled", true);
user_pref("gfx.webrender.compositor", false);
user_pref("widget.dmabuf.force-enabled", false);
user_pref("media.ffmpeg.vaapi.enabled", false);
user_pref("layout.css.devPixelsPerPx", "1.75");
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.aboutwelcome.enabled", false);
user_pref("datareporting.policy.dataSubmissionPolicyBypassNotification", true);
J
export MOZ_ENABLE_WAYLAND=1 MOZ_WEBRENDER=1 MOZ_X11_EGL=0
export MOZ_GFX_SPOOF_GL_VENDOR="${MOZ_GFX_SPOOF_GL_VENDOR-}"
exec "$HOME/gpu-stack/bin/gpu-env" "$HOME/firefox/firefox" --no-remote --profile "$P" --name firefox-gpu "$@"
