#!/usr/bin/env python3
# App icons for jsui-wl, ready to draw: jsui-icons SIZE SRC PNG [SRC PNG ...].
# SRC is an SVG (JSUI's Image decodes PNG, not SVG) or a PNG; each becomes a
# SIZE x SIZE PNG with the shell's tile shape (a rounded square, radius 28 %)
# cut out, so the shell draws it without a clip (a rounded clip per icon
# made the launcher's grid ~50 ms to paint on the Tab A7). Uses the
# system's librsvg and cairo through ctypes (Ubuntu Touch has the libraries
# but not their Python bindings). Prints each PNG written; skips icons that
# fail.
import ctypes, ctypes.util, math, os, sys

rsvg = ctypes.CDLL(ctypes.util.find_library("rsvg-2") or "librsvg-2.so.2")
cairo = ctypes.CDLL(ctypes.util.find_library("cairo") or "libcairo.so.2")


class RsvgRectangle(ctypes.Structure):
    _fields_ = [("x", ctypes.c_double), ("y", ctypes.c_double), ("width", ctypes.c_double), ("height", ctypes.c_double)]


rsvg.rsvg_handle_new_from_file.restype = ctypes.c_void_p
rsvg.rsvg_handle_new_from_file.argtypes = [ctypes.c_char_p, ctypes.c_void_p]
rsvg.rsvg_handle_render_document.restype = ctypes.c_int
rsvg.rsvg_handle_render_document.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.POINTER(RsvgRectangle), ctypes.c_void_p]
cairo.cairo_image_surface_create.restype = ctypes.c_void_p
cairo.cairo_image_surface_create.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_int]
cairo.cairo_create.restype = ctypes.c_void_p
cairo.cairo_create.argtypes = [ctypes.c_void_p]
cairo.cairo_surface_write_to_png.argtypes = [ctypes.c_void_p, ctypes.c_char_p]
cairo.cairo_destroy.argtypes = [ctypes.c_void_p]
cairo.cairo_surface_destroy.argtypes = [ctypes.c_void_p]
for name, res, args in [
    ("cairo_image_surface_create_from_png", ctypes.c_void_p, [ctypes.c_char_p]),
    ("cairo_image_surface_get_width", ctypes.c_int, [ctypes.c_void_p]),
    ("cairo_image_surface_get_height", ctypes.c_int, [ctypes.c_void_p]),
    ("cairo_surface_status", ctypes.c_int, [ctypes.c_void_p]),
    ("cairo_scale", None, [ctypes.c_void_p, ctypes.c_double, ctypes.c_double]),
    ("cairo_set_source_surface", None, [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_double, ctypes.c_double]),
    ("cairo_paint", None, [ctypes.c_void_p]),
    ("cairo_new_path", None, [ctypes.c_void_p]),
    ("cairo_arc", None, [ctypes.c_void_p] + [ctypes.c_double] * 5),
    ("cairo_close_path", None, [ctypes.c_void_p]),
    ("cairo_clip", None, [ctypes.c_void_p]),
]:
    f = getattr(cairo, name)
    f.restype = res
    f.argtypes = args
gobj = ctypes.CDLL(ctypes.util.find_library("gobject-2.0") or "libgobject-2.0.so.0")
gobj.g_object_unref.argtypes = [ctypes.c_void_p]

CAIRO_FORMAT_ARGB32 = 0


def tile_clip(cr, size):
    r = size * 0.28
    cairo.cairo_new_path(cr)
    cairo.cairo_arc(cr, size - r, r, r, -math.pi / 2, 0)
    cairo.cairo_arc(cr, size - r, size - r, r, 0, math.pi / 2)
    cairo.cairo_arc(cr, r, size - r, r, math.pi / 2, math.pi)
    cairo.cairo_arc(cr, r, r, r, math.pi, 3 * math.pi / 2)
    cairo.cairo_close_path(cr)
    cairo.cairo_clip(cr)


def render(size, src, png):
    surf = cairo.cairo_image_surface_create(CAIRO_FORMAT_ARGB32, size, size)
    cr = cairo.cairo_create(surf)
    tile_clip(cr, size)
    h = None
    if src.endswith(".png"):
        img = cairo.cairo_image_surface_create_from_png(src.encode())
        w, hh = cairo.cairo_image_surface_get_width(img), cairo.cairo_image_surface_get_height(img)
        ok = cairo.cairo_surface_status(img) == 0 and w > 0 and hh > 0
        if ok:
            cairo.cairo_scale(cr, size / w, size / hh)
            cairo.cairo_set_source_surface(cr, img, 0, 0)
            cairo.cairo_paint(cr)
        cairo.cairo_surface_destroy(img)
    else:
        h = rsvg.rsvg_handle_new_from_file(src.encode(), None)
        if not h:
            cairo.cairo_destroy(cr)
            cairo.cairo_surface_destroy(surf)
            return False
        vp = RsvgRectangle(0, 0, size, size)
        ok = rsvg.rsvg_handle_render_document(h, cr, ctypes.byref(vp), None)
    if ok:
        tmp = png + ".tmp"
        ok = cairo.cairo_surface_write_to_png(surf, tmp.encode()) == 0
        if ok:
            os.replace(tmp, png)
    cairo.cairo_destroy(cr)
    cairo.cairo_surface_destroy(surf)
    if h:
        gobj.g_object_unref(h)
    return bool(ok)


def main():
    size = int(sys.argv[1])
    args = sys.argv[2:]
    for svg, png in zip(args[0::2], args[1::2]):
        try:
            os.makedirs(os.path.dirname(png), exist_ok=True)
            if render(size, svg, png):
                print(png, flush=True)
        except Exception as e:  # one bad icon must not stop the rest
            print(f"# {svg}: {e}", file=sys.stderr, flush=True)


if __name__ == "__main__":
    main()
