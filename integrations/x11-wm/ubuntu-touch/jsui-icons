#!/usr/bin/env python3
# Rasterizes SVG app icons to PNG for jsui-wl (JSUI's Image decodes PNG, not
# SVG): jsui-icons SIZE SVG PNG [SVG PNG ...]. Uses the system's librsvg and
# cairo through ctypes (Ubuntu Touch has the libraries but not their Python
# bindings). Prints each PNG written; skips icons that fail.
import ctypes, ctypes.util, os, sys

rsvg = ctypes.CDLL(ctypes.util.find_library("rsvg-2") or "librsvg-2.so.2")
cairo = ctypes.CDLL(ctypes.util.find_library("cairo") or "libcairo.so.2")


class RsvgRectangle(ctypes.Structure):
    _fields_ = [("x", ctypes.c_double), ("y", ctypes.c_double), ("width", ctypes.c_double), ("height", ctypes.c_double)]


rsvg.rsvg_handle_new_from_file.restype = ctypes.c_void_p
rsvg.rsvg_handle_new_from_file.argtypes = [ctypes.c_char_p, ctypes.c_void_p]
rsvg.rsvg_handle_render_document.restype = ctypes.c_int
rsvg.rsvg_handle_render_document.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.POINTER(RsvgRectangle), ctypes.c_void_p]
cairo.cairo_image_surface_create.restype = ctypes.c_void_p
cairo.cairo_image_surface_create.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_int]
cairo.cairo_create.restype = ctypes.c_void_p
cairo.cairo_create.argtypes = [ctypes.c_void_p]
cairo.cairo_surface_write_to_png.argtypes = [ctypes.c_void_p, ctypes.c_char_p]
cairo.cairo_destroy.argtypes = [ctypes.c_void_p]
cairo.cairo_surface_destroy.argtypes = [ctypes.c_void_p]
gobj = ctypes.CDLL(ctypes.util.find_library("gobject-2.0") or "libgobject-2.0.so.0")
gobj.g_object_unref.argtypes = [ctypes.c_void_p]

CAIRO_FORMAT_ARGB32 = 0


def render(size, svg, png):
    h = rsvg.rsvg_handle_new_from_file(svg.encode(), None)
    if not h:
        return False
    surf = cairo.cairo_image_surface_create(CAIRO_FORMAT_ARGB32, size, size)
    cr = cairo.cairo_create(surf)
    vp = RsvgRectangle(0, 0, size, size)
    ok = rsvg.rsvg_handle_render_document(h, cr, ctypes.byref(vp), None)
    if ok:
        tmp = png + ".tmp"
        ok = cairo.cairo_surface_write_to_png(surf, tmp.encode()) == 0
        if ok:
            os.replace(tmp, png)
    cairo.cairo_destroy(cr)
    cairo.cairo_surface_destroy(surf)
    gobj.g_object_unref(h)
    return bool(ok)


def main():
    size = int(sys.argv[1])
    args = sys.argv[2:]
    for svg, png in zip(args[0::2], args[1::2]):
        try:
            os.makedirs(os.path.dirname(png), exist_ok=True)
            if render(size, svg, png):
                print(png, flush=True)
        except Exception as e:  # one bad icon must not stop the rest
            print(f"# {svg}: {e}", file=sys.stderr, flush=True)


if __name__ == "__main__":
    main()
