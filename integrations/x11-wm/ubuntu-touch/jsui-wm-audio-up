#!/bin/sh
# Speaker sound on the Galaxy Tab A7 (SM-T500) running Ubuntu Touch on
# Samsung's stock vendor partition (run as root: jsui-wm-audio.service at
# boot, or audio-on.sh by hand).
#
# The kernel had no sound card: the vendor's init modprobes Samsung's audio
# modules, built for Samsung's kernel and refused by this one (signed
# modules only, like its Wi-Fi module). udev loads the port's own builds of
# those a device asks for (the machine driver, codecs), but the rest (the
# bolero macros, the soundwire master, the codecs' soundwire slaves, ...)
# have no alias, so nothing loads them and the machine driver never makes
# the card; the vendor's audio service then fails ("Unable to find correct
# sound card"). Load them from the port's /lib/modules.
#
# PulseAudio's droid bridge (module-droid-discover in /etc/pulse/touch.pa)
# opens the vendor's generic audio HAL, audio.primary.default, in-process;
# on this vendor that one fails to open ("Invalid argument"), so PulseAudio
# is left with its fake Bluetooth sink and every sound is lost. libhybris'
# audio.hidl_compat wrapper, bound over it, talks to the vendor's own audio
# service (android.hardware.audio.service, running in the Android container)
# instead. A speaker-and-mic-only audio policy keeps the bridge's routing
# simple (the vendor's lists devices the port can't drive). Bind mounts
# only: a reboot undoes this unless the service runs it again.
HERE=$(dirname "$(readlink -f "$0")")
log() { echo "jsui-wm-audio: $*"; }
mounted() { awk -v p="$1" '$5 == p { f = 1 } END { exit !f }' /proc/self/mountinfo; }

V=/android/vendor
[ -e "$V/lib64/hw/audio.primary.default.so" ] || V=/vendor
WRAP=/android/system/lib64/hw/audio.hidl_compat.default.so
[ -e "$WRAP" ] || WRAP=/system/lib64/hw/audio.hidl_compat.default.so
POLICY="$HERE/jsui-wm-audio-policy.xml"
[ -e "$WRAP" ] || { log "no audio.hidl_compat wrapper in the Android system image."; exit 1; }

# A bring-up that takes the kernel down must not run again at every boot: a
# marker stays until the card is up (--force clears it).
MARK=/var/lib/systemd/jsui-wm-audio.trying
[ "$1" = "--force" ] && rm -f "$MARK"
card() { grep -q "^ *[0-9]" /proc/asound/cards 2>/dev/null; }
if ! card; then
  if [ -e "$MARK" ]; then
    log "an earlier bring-up never finished (crash?): not trying again. Run with --force to retry."
    exit 1
  fi
  touch "$MARK"
  for m in native_dlkm stub_dlkm swr_ctrl_dlkm va_macro_dlkm rx_macro_dlkm tx_macro_dlkm wcd937x_slave_dlkm rouleur_slave_dlkm; do
    grep -q "^$m " /proc/modules || modprobe "$m" || log "modprobe $m failed."
  done
  for i in $(seq 20); do card && break; sleep 1; done
  rm -f "$MARK"
  if ! card; then
    log "still no sound card after loading the audio modules."
    { date; cat /proc/asound/cards; cut -d" " -f1 /proc/modules | grep dlkm; dmesg | grep -iE "asoc|snd|bengal|swr|macro|wcd|rouleur|bolero" | tail -40; } > /tmp/jsui-wm-audio.log 2>&1
    chmod 644 /tmp/jsui-wm-audio.log
    exit 1
  fi
fi
log "sound card: $(sed -n 1p /proc/asound/cards | sed 's/^ *//')"

if mounted "$V/lib64/hw/audio.primary.default.so"; then
  log "audio HAL wrapper bound already."
else
  mount -o bind "$WRAP" "$V/lib64/hw/audio.primary.default.so" || { log "binding the HAL wrapper failed."; exit 1; }
  log "audio HAL wrapper bound over audio.primary.default."
fi
if [ -e "$POLICY" ] && ! mounted "$V/etc/audio_policy_configuration.xml"; then
  mount -o bind "$POLICY" "$V/etc/audio_policy_configuration.xml" && log "speaker-only audio policy bound."
fi

# The vendor's audio service (in the Android container) restarted after the
# binds, as the port's own install layer does: the wrapper reaches it over
# hwbinder (without that it fell back to loading the vendor HAL in-process,
# which fails on a missing libsndcardparser.so).
A="lxc-attach -n android --clear-env --"
$A /system/bin/setprop ctl.restart vendor.audio-hal 2>/dev/null && log "restarting the Android audio service."
for i in $(seq 20); do
  [ "$($A /system/bin/getprop init.svc.vendor.audio-hal 2>/dev/null)" = running ] && break
  sleep 1
done
sleep 2

# What the bridge needs, for when it still fails (readable by the user).
{
  date
  $A /system/bin/getprop init.svc.vendor.audio-hal
  $A /system/bin/lshal 2>/dev/null | grep -i audio
  $A /system/bin/logcat -d -t 400 2>/dev/null | grep -iE "audio|DevicesFactory|hwservicemanager|hidl" | tail -60
} > /tmp/jsui-wm-audio.log 2>&1
chmod 644 /tmp/jsui-wm-audio.log

# A PulseAudio already running (a session started before this) loaded the
# bridge without the wrapper: restart it.
for rt in /run/user/*; do
  [ -S "$rt/pulse/native" ] || continue
  u=$(stat -c %U "$rt")
  log "restarting $u's PulseAudio."
  runuser -u "$u" -- env XDG_RUNTIME_DIR="$rt" DBUS_SESSION_BUS_ADDRESS="unix:path=$rt/bus" \
    systemctl --user restart pulseaudio.service 2>/dev/null ||
    runuser -u "$u" -- env XDG_RUNTIME_DIR="$rt" pulseaudio -k 2>/dev/null
done
exit 0
