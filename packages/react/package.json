{
  "name": "@orktes/jsui-react",
  "version": "0.2.0",
  "description": "React Native compatible renderer for the JSUI game UI runtime (QuickJS + Yoga + Skia).",
  "author": "Jaakko Lukkari",
  "license": "MIT",
  "homepage": "https://github.com/orktes/jsui/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orktes/jsui.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/orktes/jsui/issues"
  },
  "keywords": [
    "jsui",
    "react",
    "react-native",
    "game-ui",
    "quickjs",
    "yoga",
    "skia"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./shims/*": "./src/shims/*.js",
    "./lottie": "./src/lottie.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": true,
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-reconciler": "0.34.0"
  }
}
