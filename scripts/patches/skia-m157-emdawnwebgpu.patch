+wgpu::BindGroup DawnResourceProvider::findOrCreateUniformBindGroup(
+        const wgpu::BindGroupLayout& layout,
+        const std::array<const BindBufferInfo*, kNumUniformEntries>& buffers) {
+    SKGPU_ASSERT_SINGLE_OWNER(fSingleOwner)
+    constexpr uint32_t kBindingIndices[kNumUniformEntries] = {
+        DawnGraphicsPipeline::kIntrinsicUniformBufferIndex,
+        DawnGraphicsPipeline::kCombinedUniformIndex,
+        DawnGraphicsPipeline::kStorageBufferIndex,
+    };
+    UniformBindGroupKey key{};
+    const uint64_t layoutBits = reinterpret_cast<uintptr_t>(layout.Get());
+    key.fData[0] = static_cast<uint32_t>(layoutBits);
+    key.fData[1] = static_cast<uint32_t>(layoutBits >> 32);
+    for (size_t i = 0; i < kNumUniformEntries; ++i) {
+        if (const BindBufferInfo* info = buffers[i]) {
+            key.fData[2 + 2 * i] = info->fBuffer->uniqueID().asUInt();
+            key.fData[3 + 2 * i] = info->fSize;
+        }
+    }
+    if (wgpu::BindGroup* cached = fUniformBindGroups.find(key)) {
+        return *cached;
+    }
+
+    std::array<wgpu::BindGroupEntry, kNumUniformEntries> entries{};
+    for (size_t i = 0; i < kNumUniformEntries; ++i) {
+        entries[i].binding = SK_UNSAFE_TODO(kBindingIndices[i]);
+        if (const BindBufferInfo* info = buffers[i]) {
+            entries[i].size = info->fSize;
+            entries[i].buffer = static_cast<const DawnBuffer*>(info->fBuffer)->dawnBuffer();
+        } else {
+            entries[i].buffer = this->getOrCreateNullBuffer();
+        }
+    }
+    wgpu::BindGroup bindGroup = this->createBindGroup(entries, layout);
+    if (bindGroup) {
+        fUniformBindGroups.insert(key, bindGroup);
+    }
+    return bindGroup;
+}
