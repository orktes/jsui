diff --git a/third_party/dawn/BUILD.gn b/third_party/dawn/BUILD.gn
index 187722e..7d12431 100644
--- a/third_party/dawn/BUILD.gn
+++ b/third_party/dawn/BUILD.gn
@@ -132,7 +132,9 @@ group("tint") {
 }
 
 config("dawn_api_config") {
