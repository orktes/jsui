diff --git a/third_party/dawn/args.gni b/third_party/dawn/args.gni
index 755562f..bc8ce6f 100644
--- a/third_party/dawn/args.gni
+++ b/third_party/dawn/args.gni
@@ -10,4 +10,10 @@ declare_args() {
   dawn_enable_metal = is_mac || is_ios
   dawn_enable_vulkan = is_linux || is_android
   dawn_use_agility_sdk = false
+
+  # JSUI: compile Graphite against the Dawn headers in this include dir (Dawn's
+  # generated include/: dawn/webgpu.h, webgpu/webgpu_cpp.h, ...) instead of
+  # building and linking Dawn. The wgpu* entry points stay undefined for the
+  # final binary to provide (JSUI resolves them from the host at run time).
+  skia_dawn_header_only_include_dir = ""
 }
