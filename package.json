{
  "name": "jsui-monorepo",
  "private": true,
  "workspaces": ["packages/*", "tests/reference", "web", "site"],
  "scripts": {
    "test:js": "npm --workspace @orktes/jsui-react --workspace @orktes/jsui-cli test",
    "test:reference": "npm --workspace tests/reference run test --",
    "test:web": "npm --workspace web run test:web",
    "site:build": "npm --workspace site run build",
    "site:test": "npm --workspace site run test"
  }
}
